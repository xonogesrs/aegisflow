{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoLoop C3C commit intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "idempotency_key", "execution_id", "card_id", "card_revision", "candidate_id", "candidate_revision", "candidate_tree", "candidate_manifest_digest", "expected_head", "retention_reference", "review_artifact_digest", "review_verdict", "repository_identity", "git_common_dir_identity", "target_ref", "commit_subject", "commit_body", "author_name", "author_email", "author_date", "committer_name", "committer_email", "committer_date", "signing_mode", "authorization_id", "authorization_canonical_digest", "created_at"],
  "properties": {
    "schema": {"const": "autoloop.commit-intent/v1"},
    "idempotency_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "pattern": "^exec_[0-9a-f]{32}$"},
    "card_id": {"type": "string", "minLength": 1},
    "card_revision": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^cand_exec_[0-9a-f]{32}_r[1-9][0-9]*$"},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "retention_reference": {"type": "string", "pattern": "^refs/autoloop/candidates/cand_exec_[0-9a-f]{32}_r[1-9][0-9]*$"},
    "review_artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_verdict": {"const": "PASS"},
    "repository_identity": {"type": "string", "minLength": 1},
    "git_common_dir_identity": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "pattern": "^refs/heads/.+$"},
    "commit_subject": {"type": "string", "minLength": 1},
    "commit_body": {"type": "string"},
    "author_name": {"type": "string", "minLength": 1},
    "author_email": {"type": "string", "minLength": 1},
    "author_date": {"type": "string", "minLength": 1},
    "committer_name": {"type": "string", "minLength": 1},
    "committer_email": {"type": "string", "minLength": 1},
    "committer_date": {"type": "string", "minLength": 1},
    "signing_mode": {"const": "none"},
    "authorization_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1}
  }
}

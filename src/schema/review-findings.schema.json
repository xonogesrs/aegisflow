{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoLoop review findings artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "jobId", "lineageId", "generation",
    "candidateIdentity", "specIdentity", "reviewerIdentity",
    "findings", "summary", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "autoloop.review-findings/v1" },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "lineageId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generation": { "type": "integer", "minimum": 1 },
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changedTreeIdentity", "patchSha256", "currentHead", "baseHead", "repository", "branch"],
      "properties": {
        "changedTreeIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "patchSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "currentHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "specIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specId", "specDigest"],
      "properties": {
        "specId": { "type": "string", "minLength": 1 },
        "specDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "reviewerIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "subject", "description", "recommendedDisposition"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["BLOCKER", "MAJOR", "MINOR", "INFO"] },
          "subject": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "violatedInvariant": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "recommendedDisposition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}

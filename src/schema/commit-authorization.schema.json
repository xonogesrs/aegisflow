{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AegisFlow C3C durable commit authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorization_id",
    "card_id",
    "card_revision",
    "execution_id",
    "candidate_id",
    "candidate_revision",
    "review_artifact_digest",
    "review_verdict",
    "expected_head",
    "target_ref",
    "candidate_tree",
    "candidate_manifest_digest",
    "exact_changed_paths",
    "commit_subject",
    "commit_body",
    "author_name",
    "author_email",
    "author_date",
    "committer_name",
    "committer_email",
    "committer_date",
    "commit_allowed",
    "authorized_by",
    "authorization_source",
    "authorization_ref",
    "authorized_at",
    "canonical_digest"
  ],
  "properties": {
    "schema": { "const": "autoloop.commit-authorization/v1" },
    "authorization_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "card_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "card_revision": { "type": "string", "minLength": 1, "maxLength": 64 },
    "execution_id": { "type": "string", "pattern": "^exec_[0-9a-f]{32}$" },
    "candidate_id": { "type": "string", "pattern": "^cand_exec_[0-9a-f]{32}_r[1-9][0-9]*$" },
    "candidate_revision": { "type": "integer", "minimum": 1 },
    "review_artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "review_verdict": { "const": "PASS" },
    "expected_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target_ref": { "type": "string", "pattern": "^refs/heads/[^\\s~^:?*\\[\\]\\\\]+$" },
    "candidate_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "exact_changed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "commit_subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "commit_body": { "type": "string", "maxLength": 10000 },
    "author_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "author_email": { "type": "string", "minLength": 1, "maxLength": 320 },
    "author_date": { "type": "string", "minLength": 1, "maxLength": 64 },
    "committer_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "committer_email": { "type": "string", "minLength": 1, "maxLength": 320 },
    "committer_date": { "type": "string", "minLength": 1, "maxLength": 64 },
    "commit_allowed": { "const": true },
    "authorized_by": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authorization_source": { "type": "string", "enum": ["controller_operator"] },
    "authorization_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authorized_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "canonical_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AegisFlow reviewed commit candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "candidate_revision", "status", "execution_id", "card_id", "card_revision", "source_checkpoint_revision", "authority_record_digest", "execution_context_digest", "mutation_authority_digest", "review_artifact_digest", "review_verdict", "repository_identity", "git_common_dir_identity", "source_worktree_identity", "expected_head", "expected_origin_master", "candidate_tree", "candidate_parent", "exact_changed_paths", "tree_entries", "candidate_manifest_digest", "retention_kind", "retention_reference", "created_at", "expires_at"],
  "properties": {
    "schema": {"const": "autoloop.reviewed-commit-candidate/v1"},
    "candidate_id": {"type": "string", "pattern": "^cand_exec_[0-9a-f]{32}_r[1-9][0-9]*$"},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["CAPTURE_INTENT", "CAPTURED", "VERIFIED", "READY_FOR_COMMIT_AUTHORIZATION", "MATERIALIZATION_INTENT", "MATERIALIZED_VERIFIED", "EXPIRED", "HOLD"]},
    "execution_id": {"type": "string", "pattern": "^exec_[0-9a-f]{32}$"},
    "card_id": {"type": "string", "minLength": 1},
    "card_revision": {"type": "string", "minLength": 1},
    "source_checkpoint_revision": {"type": "integer", "minimum": 0},
    "authority_record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mutation_authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_artifact_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "review_verdict": {"type": ["string", "null"], "enum": [null, "PASS", "HOLD", "NEEDS_SUPPLEMENT", "REJECT"]},
    "repository_identity": {"type": "string", "minLength": 1},
    "git_common_dir_identity": {"type": "string", "minLength": 1},
    "source_worktree_identity": {"type": "string", "minLength": 1},
    "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_origin_master": {"type": "string"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_parent": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "exact_changed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tree_entries": {"type": "array", "minItems": 1},
    "candidate_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retention_kind": {"const": "git_tree_ref"},
    "retention_reference": {"type": "string", "pattern": "^refs/autoloop/candidates/cand_exec_[0-9a-f]{32}_r[1-9][0-9]*$"},
    "created_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1}
  }
}

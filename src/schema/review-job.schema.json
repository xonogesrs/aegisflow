{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoLoop review-job binding identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "lineageId", "jobId", "generation",
    "candidateIdentity", "specId", "specDigest", "state", "stateVersion"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "autoloop.review-job/v1" },
    "lineageId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "generation": { "type": "integer", "minimum": 1 },
    "repoIdentity": { "type": "string", "minLength": 1 },
    "worktreeIdentity": { "type": "string", "minLength": 1 },
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changedTreeIdentity", "patchSha256", "currentHead", "baseHead", "repository", "branch"],
      "properties": {
        "changedTreeIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "patchSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "currentHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "specId": { "type": "string", "minLength": 1 },
    "specDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "repairRound": { "type": "integer", "minimum": 0 },
    "priorJobId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "priorFindingsDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "priorVerdictDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "findingsDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verdictDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "supersedes": { "type": "string", "minLength": 1, "maxLength": 256 },
    "supersededBy": { "type": "string", "minLength": 1, "maxLength": 256 },
    "requiredArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "required", "writeMode"],
        "properties": {
          "role": { "type": "string", "enum": ["findings", "verdict"] },
          "required": { "type": "boolean" },
          "writeMode": { "type": "string", "enum": ["exclusive-create", "cas"] },
          "canonicalPath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "REQUIRED", "PREPARED", "RUNNING", "FINDINGS_CAPTURED",
        "VERDICT_PRODUCED", "PERSISTED", "STAGED", "ACCEPTED",
        "DOWNSTREAM_AUTHORIZED", "SUPERSEDED", "HOLD"
      ]
    },
    "stateVersion": { "type": "integer", "minimum": 1 },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "acceptanceAuthority": { "type": "string", "minLength": 1 }
  }
}

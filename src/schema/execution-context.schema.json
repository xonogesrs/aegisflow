{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoLoop execution context — non-authoritative, write-once runtime projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "authority_digest",
    "resolved_designer",
    "resolved_executor",
    "resolved_reviewer",
    "resolved_fallback_reviewer",
    "resolved_challenge_model",
    "subprocess_timeout_ms",
    "worktree_path",
    "policy_version",
    "designer_prompt_version",
    "reviewer_prompt_version",
    "repository_verification"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "autoloop.execution-context/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^exec_[0-9a-f]{32}$",
      "description": "Minted via c2d/execution-id.mjs mintExecutionId()."
    },
    "authority_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Binds this context to exactly one authority_record. Not itself an authority source."
    },
    "resolved_designer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "resolved_executor": { "type": "string", "minLength": 1, "maxLength": 256 },
    "resolved_reviewer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "resolved_fallback_reviewer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "resolved_challenge_model": { "type": ["string", "null"], "maxLength": 256 },
    "subprocess_timeout_ms": { "type": "integer", "minimum": 1000 },
    "worktree_path": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "designer_prompt_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "reviewer_prompt_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "repository_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_head", "ahead", "behind", "worktree_state", "verified_at"],
      "properties": {
        "origin_head": { "type": "string" },
        "ahead": { "type": "integer", "minimum": 0 },
        "behind": { "type": "integer", "minimum": 0 },
        "worktree_state": { "type": "string", "enum": ["clean", "dirty"] },
        "verified_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AegisFlow reviewer verdict",
  "type": "object",
  "required": ["verdict", "confidence", "model", "summary", "recommended_next_action"],
  "additionalProperties": true,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "HOLD", "NEEDS_SUPPLEMENT", "REJECT"]
    },
    "confidence": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "model": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "blocking_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_supplements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scope_violations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_next_action": {
      "type": "string",
      "enum": ["STOP", "REPAIR", "EXTERNAL_REVIEW"]
    }
  }
}
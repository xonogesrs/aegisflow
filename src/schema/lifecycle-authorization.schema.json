{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autoloop.lifecycle-authorization/v2",
  "title": "AutoLoop Review-Unit Lifecycle Authorization",
  "description": "Entry-card-level authorization for one coherent review unit: decompose → execute internal milestones → local checkpoint commits → full verification → desktop external review bundle → WAITING_FOR_EXTERNAL_REVIEW → external PASS → integration commit → feature-branch push → draft PR (integration record only). Fail-closed: any capability not explicitly allowed is denied; restrictive requirements can never be cancelled by a looser runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "card_id", "run_id", "repository", "worktree", "branch", "base", "base_head", "authorized_paths", "bundle_path", "lifecycle_authorization"],
  "properties": {
    "schema": { "type": "string", "const": "autoloop.lifecycle-authorization/v2" },
    "card_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "card_revision": { "type": "string", "minLength": 1, "maxLength": 64 },
    "issued_at": { "type": "string", "format": "date-time" },
    "authorized_by": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authorization_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "repository": { "type": "string", "minLength": 1, "maxLength": 256 },
    "worktree": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "branch": { "type": "string", "minLength": 1, "maxLength": 128 },
    "base": { "type": "string", "minLength": 1, "maxLength": 128 },
    "base_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authorized_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "bundle_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "lifecycle_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decomposition", "independent_review", "bounded_repair", "checkpoint_commit", "feature_branch_push", "draft_pr", "external_review", "review_unit", "merge_main", "release", "seal"],
      "properties": {
        "decomposition": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "max_depth", "max_total_nodes"],
          "properties": {
            "allowed": { "type": "boolean" },
            "max_depth": { "type": "integer", "minimum": 0, "maximum": 16 },
            "max_total_nodes": { "type": "integer", "minimum": 0, "maximum": 1024 }
          }
        },
        "independent_review": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "require_fresh_session", "require_same_artifact_digest"],
          "properties": {
            "allowed": { "type": "boolean" },
            "require_fresh_session": { "type": "boolean" },
            "require_same_artifact_digest": { "type": "boolean" }
          }
        },
        "bounded_repair": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "max_rounds", "scope_expansion"],
          "properties": {
            "allowed": { "type": "boolean" },
            "max_rounds": { "type": "integer", "minimum": 0, "maximum": 2 },
            "scope_expansion": { "type": "boolean" }
          }
        },
        "checkpoint_commit": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "require_local_gates_pass", "require_clean_index_before_stage", "require_expected_paths_only"],
          "properties": {
            "allowed": { "type": "boolean" },
            "require_local_gates_pass": { "type": "boolean" },
            "require_clean_index_before_stage": { "type": "boolean" },
            "require_expected_paths_only": { "type": "boolean" }
          }
        },
        "feature_branch_push": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "branch_pattern", "force_push", "require_remote_ancestor_check"],
          "properties": {
            "allowed": { "type": "boolean" },
            "branch_pattern": { "type": "string", "minLength": 1, "maxLength": 128 },
            "force_push": { "type": "boolean" },
            "require_remote_ancestor_check": { "type": "boolean" }
          }
        },
        "draft_pr": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "base_branch", "draft_only", "create_if_missing", "update_if_present"],
          "properties": {
            "allowed": { "type": "boolean" },
            "base_branch": { "type": "string", "minLength": 1, "maxLength": 128 },
            "draft_only": { "type": "boolean" },
            "create_if_missing": { "type": "boolean" },
            "update_if_present": { "type": "boolean" }
          }
        },
        "external_review": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "require_bundle", "bundle_path"],
          "properties": {
            "required": { "type": "boolean" },
            "require_bundle": { "type": "boolean" },
            "bundle_path": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "review_unit": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "repository_count", "worktree_count", "parent_card_count", "architecture_goal_count", "maximum_internal_milestones", "maximum_changed_paths", "maximum_patch_lines", "maximum_repair_rounds"],
          "properties": {
            "allowed": { "type": "boolean" },
            "repository_count": { "type": "integer", "minimum": 1, "maximum": 1 },
            "worktree_count": { "type": "integer", "minimum": 1, "maximum": 1 },
            "parent_card_count": { "type": "integer", "minimum": 1, "maximum": 1 },
            "architecture_goal_count": { "type": "integer", "minimum": 1, "maximum": 1 },
            "maximum_internal_milestones": { "type": "integer", "minimum": 1, "maximum": 3 },
            "maximum_changed_paths": { "type": "integer", "minimum": 1, "maximum": 64 },
            "maximum_patch_lines": { "type": "integer", "minimum": 1, "maximum": 20000 },
            "maximum_repair_rounds": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        },
        "merge_main": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed"],
          "properties": { "allowed": { "type": "boolean", "const": false } }
        },
        "release": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed"],
          "properties": { "allowed": { "type": "boolean", "const": false } }
        },
        "seal": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed"],
          "properties": { "allowed": { "type": "boolean", "const": false } }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoLoop Task Decomposition Output",
  "description": "Three-way union: NOT_BENEFICIAL / DECOMPOSED / BLOCKED",

  "oneOf": [
    {
      "title": "DECOMPOSITION_NOT_BENEFICIAL",
      "type": "object",
      "required": ["verdict", "reason", "decomposition_evidence"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "const": "DECOMPOSITION_NOT_BENEFICIAL" },
        "reason": { "type": "string", "minLength": 1 },
        "decomposition_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    {
      "title": "DECOMPOSED",
      "type": "object",
      "required": [
        "verdict", "parent_goal", "execution_policy",
        "child_cards", "edges",
        "deferred_items", "unresolved_items",
        "coverage_map", "decomposition_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": { "const": "DECOMPOSED" },
        "parent_goal": { "type": "string", "minLength": 1 },
        "execution_policy": {
          "type": "object",
          "required": ["executor", "reviewer", "multi_model_orchestration"],
          "additionalProperties": false,
          "properties": {
            "executor": { "const": "INHERIT_PARENT" },
            "reviewer": { "const": "EXTERNAL_GPT" },
            "multi_model_orchestration": { "const": false }
          }
        },
        "child_cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["card_id", "role_id", "goal", "card_type", "authority_required", "verification", "risk_level"],
            "additionalProperties": false,
            "properties": {
              "card_id": { "type": "string", "minLength": 1 },
              "role_id": { "type": "string", "minLength": 1 },
              "goal": { "type": "string", "minLength": 1 },
              "card_type": {
                "type": "string",
                "enum": ["READ_ONLY_AUDIT", "IMPLEMENTATION", "REPAIR", "RUNTIME_VALIDATION", "EXTERNAL_REVIEW"]
              },
              "prerequisites": { "type": "array", "items": { "type": "string" }, "default": [] },
              "allowed_paths": { "type": "array", "items": { "type": "string" }, "default": [] },
              "forbidden_actions": { "type": "array", "items": { "type": "string" }, "default": [] },
              "authority_required": {
                "type": "object",
                "required": ["commit_allowed", "push_allowed", "mutation_allowed"],
                "additionalProperties": false,
                "properties": {
                  "commit_allowed": { "type": "boolean" },
                  "push_allowed": { "type": "boolean" },
                  "mutation_allowed": { "type": "boolean" }
                }
              },
              "verification": {
                "type": "object",
                "required": ["required_commands", "forbidden_commands"],
                "additionalProperties": false,
                "properties": {
                  "required_commands": { "type": "array", "items": { "type": "string" }, "default": [] },
                  "forbidden_commands": { "type": "array", "items": { "type": "string" }, "default": [] }
                }
              },
              "hard_stop": { "type": "array", "items": { "type": "string" }, "default": [] },
              "risk_level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["depends_on"], "default": "depends_on" }
            }
          }
        },
        "deferred_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement_id", "reason_code"],
            "additionalProperties": false,
            "properties": {
              "requirement_id": { "type": "string", "minLength": 1 },
              "reason_code": {
                "type": "string",
                "enum": ["COMMIT_NOT_AUTHORIZED", "CROSS_REPO_AUTHORITY_REQUIRED", "PRODUCTION_RUNTIME_OUT_OF_SCOPE", "MULTI_MODEL_ORCHESTRATION_FORBIDDEN", "OTHER"]
              },
              "reason": { "type": "string" }
            }
          },
          "default": []
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement_id", "reason_code"],
            "additionalProperties": false,
            "properties": {
              "requirement_id": { "type": "string", "minLength": 1 },
              "reason_code": {
                "type": "string",
                "enum": ["CYCLIC_DEPENDENCY", "AMBIGUOUS_SCOPE", "MISSING_AUTHORITY", "PRODUCTION_RUNTIME_OUT_OF_SCOPE", "OTHER"]
              },
              "question": { "type": "string" }
            }
          },
          "default": []
        },
        "coverage_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement_id", "role_id", "verification"],
            "additionalProperties": false,
            "properties": {
              "requirement_id": { "type": "string", "minLength": 1 },
              "role_id": { "type": "string", "minLength": 1 },
              "verification": { "type": "string", "minLength": 1 }
            }
          },
          "default": []
        },
        "decomposition_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    {
      "title": "DECOMPOSITION_BLOCKED",
      "type": "object",
      "required": ["verdict", "unresolved_items", "decomposition_evidence"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "const": "DECOMPOSITION_BLOCKED" },
        "unresolved_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["requirement_id", "reason_code"],
            "additionalProperties": false,
            "properties": {
              "requirement_id": { "type": "string", "minLength": 1 },
              "reason_code": {
                "type": "string",
                "enum": ["CYCLIC_DEPENDENCY", "AMBIGUOUS_SCOPE", "MISSING_AUTHORITY", "OTHER"]
              },
              "question": { "type": "string" }
            }
          }
        },
        "decomposition_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    }
  ]
}

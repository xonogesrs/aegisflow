{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Implementation Evidence — structured record of an executor's work against a Role Contract",
  "type": "object",
  "additionalProperties": false,
  "description": "Structural validity does NOT prove: the patch hash is correct, changed paths are truly a subset of authorized paths, the contract hash exists, or the repository baseline is current. Those are cross-artifact checks belonging to later storage/lineage cards, NOT implemented here.",
  "required": [
    "schema_version",
    "contract_id",
    "design_revision_id",
    "design_contract_hash",
    "implementation_attempt_id",
    "parent_attempt_id",
    "executor_invocation",
    "repository_baseline",
    "initial_integrity",
    "final_integrity",
    "authorized_paths",
    "actual_changed_paths",
    "patch_sha256",
    "commands",
    "compile_results",
    "test_results",
    "negative_evidence",
    "mutation_evidence",
    "skipped_evidence",
    "known_failures",
    "environment_limits",
    "scope_deviations",
    "executor_verdict",
    "timestamps",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "autoloop.implementation-evidence/v1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x20-\\x7E]+$"
    },
    "design_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x20-\\x7E]+$"
    },
    "design_contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hash of the design contract document. Lowercase hex."
    },
    "implementation_attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x20-\\x7E]+$"
    },
    "parent_attempt_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 128,
      "pattern": "^[\\x20-\\x7E]*$"
    },
    "executor_invocation": {
      "$ref": "model-invocation.schema.json",
      "description": "Invocation record for the executor model that produced this evidence. Runtime validation reuses validateModelInvocation()."
    },
    "repository_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "head", "origin_ref", "origin_head", "ahead", "behind", "expected_worktree_state", "permitted_dirty_paths", "captured_at"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "origin_ref": { "type": "string", "minLength": 1 },
        "origin_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "ahead": { "type": "integer", "minimum": 0 },
        "behind": { "type": "integer", "minimum": 0 },
        "expected_worktree_state": { "type": "string", "enum": ["clean", "dirty"] },
        "permitted_dirty_paths": { "type": "array", "items": { "type": "string" } },
        "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
      }
    },
    "initial_integrity": {
      "type": "string",
      "minLength": 1,
      "description": "Integrity state before execution."
    },
    "final_integrity": {
      "type": "string",
      "minLength": 1,
      "description": "Integrity state after execution."
    },
    "authorized_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!\\.\\./)(?!\\.\\.$)(?!\\.*$)(?!\\s*$).+$"
      },
      "description": "Repo-relative authorized paths. Leading '/', '../', and empty strings rejected by validator."
    },
    "actual_changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!\\.\\./)(?!\\.\\.$)(?!\\.*$)(?!\\s*$).+$"
      },
      "description": "Repo-relative paths actually changed. Same normalization rules as authorized_paths."
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hash of the complete patch/diff. Lowercase hex."
    },
    "commands": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "exit_code"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["ok", "failed", "timed_out", "skipped"] },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "compile_results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "exit_code"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["ok", "failed", "timed_out", "skipped"] },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "test_results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_identifier", "outcome", "command"],
        "properties": {
          "test_identifier": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "enum": ["passed", "failed", "ignored", "skipped", "environment_excluded"] },
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "negative_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence_type"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "evidence_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mutation_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change_type"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "change_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skipped_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "reason"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_failures": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "severity"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }
        }
      }
    },
    "environment_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_path_length": { "type": "integer", "minimum": 0 },
        "max_command_results": { "type": "integer", "minimum": 0 },
        "max_test_results": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "scope_deviations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "authorized"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "authorized": { "type": "boolean" }
        }
      }
    },
    "executor_verdict": {
      "type": "string",
      "minLength": 1,
      "description": "Executor's self-verdict on the implementation."
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at"],
      "properties": {
        "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
        "completed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
      }
    },
    "integrity": {
      "type": "string",
      "minLength": 1,
      "description": "Integrity section for this evidence bundle."
    }
  }
}

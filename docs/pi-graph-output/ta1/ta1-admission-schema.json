{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autoloop.task-admission/v1",
  "title": "AutoLoop Task Admission Result",
  "description": "Single machine-readable admission decision for one task, produced BEFORE Graph execution. One decision system answers size + risk + lifecycle weight + capability grants + review/repair/evidence strength + isolation/durability + human gates + review-surface policy. Deterministic, explainable, fail-closed, versioned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "task_id", "admission_id", "decision_time", "classifier_version",
    "size", "risk", "profile", "reasons", "capabilities", "lifecycle_profile", "isolation_policy",
    "durability_policy", "memory_policy", "review_policy", "repair_budget", "evidence_policy",
    "human_gates", "review_surface_policy", "authority_binding", "fail_closed"
  ],
  "properties": {
    "schema": { "const": "autoloop.task-admission/v1" },
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "admission_id": { "type": "string", "minLength": 1, "description": "deterministic: sha256(canonical({task_id, classifier_version, size, risk, profile, input evidence digest})) — same inputs -> same admission_id" },
    "decision_time": { "type": "string", "format": "date-time" },
    "classifier_version": { "type": "string", "const": "1.0.0", "description": "classification function version; changing classifiers bumps this and version-binds all decisions" },
    "size": { "enum": ["XS", "S", "M", "L", "XL"] },
    "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "profile": { "enum": ["FAST_PATH", "STANDARD", "MEDIUM", "MEDIUM_LARGE", "LARGE_LOW", "HIGH", "CRITICAL"] },
    "size_details": {
      "type": "object",
      "required": ["total_score", "dimensions"],
      "properties": {
        "total_score": { "type": "integer", "minimum": 0, "maximum": 30 },
        "dimensions": {
          "type": "object",
          "description": "each of the ten size dimensions -> {score: 0..3, reasons: [string]}",
          "additionalProperties": {
            "type": "object",
            "required": ["score", "reasons"],
            "properties": {
              "score": { "type": "integer", "minimum": 0, "maximum": 3 },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "under_classified": { "type": "boolean", "default": false, "description": "true when evidence was insufficient for >=1 dimension" }
      }
    },
    "risk_details": {
      "type": "object",
      "required": ["signals"],
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["signal_id", "class", "triggered", "reason"],
            "properties": {
              "signal_id": { "type": "string" },
              "class": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
              "triggered": { "type": "boolean" },
              "reason": { "type": "string" }
            }
          }
        },
        "escalation_log": { "type": "array", "items": { "type": "string" }, "description": "record of every fail-closed escalation and its trigger" }
      }
    },
    "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "human-readable justification for size + risk + profile" },
    "capabilities": {
      "type": "object",
      "required": ["required", "allowed", "denied"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" }, "description": "capabilities that MUST be used (e.g. independent_review for HIGH)" },
        "allowed": { "type": "array", "items": { "type": "string" } },
        "denied": { "type": "array", "items": { "type": "string" }, "description": "fail-closed: anything not listed in required/allowed is denied" }
      }
    },
    "lifecycle_profile": {
      "type": "object",
      "required": ["direct_execution_allowed", "decomposition_required", "research_first_required", "readonly_exploration_required", "subagent_required", "writer_allowed"],
      "properties": {
        "direct_execution_allowed": { "type": "boolean" },
        "decomposition_required": { "type": "boolean" },
        "decomposition_depth_bound": { "type": ["integer", "null"], "minimum": 0, "maximum": 64 },
        "research_first_required": { "type": "boolean" },
        "readonly_exploration_required": { "type": "boolean" },
        "subagent_required": { "type": "boolean" },
        "writer_allowed": { "type": "boolean" }
      }
    },
    "isolation_policy": { "enum": ["none", "host", "worktree", "colima"], "description": "colima implies worktree for writers" },
    "durability_policy": { "enum": ["ephemeral", "durable", "durable_resume"] },
    "memory_policy": {
      "type": "object",
      "required": ["retrieval_allowed", "writeback_allowed"],
      "properties": {
        "retrieval_allowed": { "type": "boolean" },
        "writeback_allowed": { "type": "boolean", "description": "default false; true requires explicit admission (CRITICAL-class signal)" }
      }
    },
    "review_policy": {
      "type": "object",
      "required": ["strength", "independent_review_required", "external_review_required", "strict_reviewer_routing"],
      "properties": {
        "strength": { "enum": ["none", "deterministic", "independent", "external"] },
        "independent_review_required": { "type": "boolean" },
        "external_review_required": { "type": "boolean" },
        "strict_reviewer_routing": { "type": "boolean", "description": "true iff risk HIGH/CRITICAL (isStrictReviewRisk)" }
      }
    },
    "repair_budget": { "type": "integer", "minimum": 0, "maximum": 64, "description": "bounded by effective_repair_cap at runtime" },
    "evidence_policy": { "enum": ["none", "ephemeral", "persistent"] },
    "human_gates": {
      "type": "array",
      "items": { "enum": ["controller_pre_execution", "controller_before_external_effect", "controller_before_writeback", "controller_closeout"] },
      "description": "empty array = no human gate"
    },
    "review_surface_policy": {
      "type": "object",
      "required": ["authoritative_single_surface", "chain", "generation_policy"],
      "properties": {
        "authoritative_single_surface": { "const": true },
        "chain": { "enum": ["linear"] },
        "generation_policy": {
          "type": "array",
          "items": { "enum": ["supersede_previous", "preserve_history", "self_contained_chain", "no_chat_dependence", "revalidate_before_delivery"] }
        }
      }
    },
    "authority_binding": {
      "type": "object",
      "required": ["authority_record_digest", "subset_of_lifecycle_authorization"],
      "properties": {
        "authority_record_digest": { "type": "string", "description": "digest of the lifecycle authority record this admission must be a subset of" },
        "subset_of_lifecycle_authorization": { "const": true }
      }
    },
    "fail_closed": { "const": true, "description": "the runtime treats any unrecognized admission field/unknown capability as DENIED; malformed admission -> HOLD" },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "backward-compatible extension point: additive optional fields only; unknown extensions ignored under fail-closed semantics (they never grant capability)"
    }
  }
}

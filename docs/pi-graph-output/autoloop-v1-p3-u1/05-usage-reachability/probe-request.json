{
  "executor": "pi",
  "executablePath": "resolved via PATH",
  "args": [
    "--mode",
    "rpc",
    "--no-session",
    "--no-tools",
    "--no-extensions",
    "--no-skills",
    "--no-prompt-templates",
    "--no-themes",
    "--no-context-files",
    "--provider",
    "deepseek",
    "--model",
    "deepseek-v4-flash"
  ],
  "envAllowlist": [
    "PATH",
    "HOME",
    "TMPDIR",
    "LANG",
    "LC_ALL",
    "TERM"
  ],
  "prompt": "Reply with exactly USAGE_PROBE_OK and do not add any other text.",
  "timeoutMs": 60000
}
    {
      "step": "exported/copied artifact",
      "input": "selection result",
      "selector": "export step",
      "authoritativeSource": "Current/review-bundle.txt",
      "persistentState": "Current/review-bundle.txt",
      "expected": "TA-3 bundle sha",
      "observed": "sha 921360ad22fa1dc0... = TA-2R f7f168aa bundle (identical bytes)"

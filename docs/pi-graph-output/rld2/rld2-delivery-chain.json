    {
      "step": "external-review delivery selection",
      "input": "controller asks for next-card review bundle",
      "selector": "none in repo — controller-side export dereferences Current/ (single-slot surface)",
      "authoritativeSource": "Current/delivery.json + Current/review-bundle.txt",
      "persistentState": "Current/",
      "expected": "delivered.card_id == current.card_id (AUTOLOOP-TA3)",
      "observed": "returned AUTOLOOP-TA2 f7f168aa (STALE — first identity divergence)"
